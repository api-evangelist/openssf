          "name": "Get Scorecard report for a repository",
          "request": {
            "name": "Get Scorecard report for a repository",
            "description": {
              "content": "Return the most recent Scorecard report for a public repository on a supported source-control platform. Reports include the aggregate score, the date of evaluation, the Scorecard version, and per-check scores with documentation URLs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":platform",
                ":org",
                ":repo"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
