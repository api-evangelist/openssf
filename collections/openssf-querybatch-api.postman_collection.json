              "raw": "{\n  \"queries\": [\n    {\n      \"commit\": \"<string>\",\n      \"version\": \"<string>\",\n      \"package\": {\n        \"name\": \"<string>\",\n        \"ecosystem\": \"<string>\",\n        \"purl\": \"<string>\"\n      },\n      \"page_token\": \"<string>\"\n    },\n    {\n      \"commit\": \"<string>\",\n      \"version\": \"<string>\",\n      \"package\": {\n        \"name\": \"<string>\",\n        \"ecosystem\": \"<string>\",\n        \"purl\": \"<string>\"\n      },\n      \"page_token\": \"<string>\"\n    }\n  ]\n}",
